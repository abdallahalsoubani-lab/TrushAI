# Smart Waste Monitoring System - Environment Configuration
# ===========================================================
# Copy this file to .env and adjust values as needed

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL
# For PostgreSQL (production): postgresql://user:password@localhost:5432/smart_waste
# For SQLite (development): sqlite:///./data/smart_waste.db
DATABASE_URL=sqlite:///./data/smart_waste.db

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File upload settings
MAX_UPLOAD_SIZE_MB=100
STORE_UPLOADED_FILES=true

# Debug mode (saves overlay images, cropped bins, metadata JSON)
DEBUG_MODE=false

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Cache settings (for backward compatibility)
CACHE_TTL_SECONDS=300

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# YOLO detection
YOLO_MODEL_SIZE=n
YOLO_DEVICE=cpu
YOLO_CONFIDENCE_THRESHOLD=0.25

# Fill level classification
MOCK_CLASSIFIER_MODE=brightness
BRIGHTNESS_EMPTY_THRESHOLD=150
BRIGHTNESS_HALF_THRESHOLD=100
EDGE_EMPTY_THRESHOLD=0.05
EDGE_HALF_THRESHOLD=0.15

# =============================================================================
# VIDEO PROCESSING
# =============================================================================

FRAME_EXTRACTION_RATE=2
MAX_FRAMES_PER_VIDEO=50
VIDEO_SAMPLE_INTERVAL_SECONDS=3

# =============================================================================
# AGGREGATION
# =============================================================================

VOTING_STRATEGY=majority
MIN_DETECTIONS_FOR_VALID_BIN=3

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO

# =============================================================================
# AUTHENTICATION (Optional)
# =============================================================================

# Admin password for protected endpoints (leave empty to disable)
ADMIN_PASSWORD=

# Secret key for JWT tokens
SECRET_KEY=dev-secret-key-change-in-production

# =============================================================================
# NOTIFICATIONS (Optional)
# =============================================================================

# Webhook URL for alerts (POST request sent when bins are FULL)
WEBHOOK_URL=

# Email settings for alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
