# Smart Waste Monitoring System - Environment Configuration
# ===========================================================
# Copy this file to .env and adjust values as needed

# Application
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# AI Configuration
YOLO_MODEL_SIZE=n
YOLO_DEVICE=cpu
MOCK_CLASSIFIER_MODE=brightness

# Video Processing
FRAME_EXTRACTION_RATE=2
MAX_FRAMES_PER_VIDEO=50

# Aggregation
VOTING_STRATEGY=majority
MIN_DETECTIONS_FOR_VALID_BIN=3
